# Copy this file to the repository root as .env, then generate two distinct
# random values (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`).
# Never commit .env or use these example placeholders in a deployed environment.
FLASK_SECRET_KEY=replace-with-a-random-64-character-hex-value
JWT_SECRET_KEY=replace-with-a-different-random-64-character-hex-value
JWT_ACCESS_TOKEN_MINUTES=30
FLASK_DEBUG=false

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# Replace these with an existing MySQL account and its password before use.
MYSQL_USER=replace-with-your-mysql-user
MYSQL_PASSWORD=replace-with-your-mysql-password
MYSQL_DATABASE=freelancer_pms

# SMTP is required to deliver password-reset links. Use an app password or
# provider token here; never commit real mail credentials.
# Leave SMTP values blank for local console-link testing, or set real provider values.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
APP_BASE_URL=http://127.0.0.1:5000
PASSWORD_RESET_TOKEN_MINUTES=15
# Optional local-only fallback: when true, no SMTP is configured, and the
# request comes from loopback, the reset link is printed to the Flask console.
# Never enable this on a public deployment.
PASSWORD_RESET_DEV_MODE=false
